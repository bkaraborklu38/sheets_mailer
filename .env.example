# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env dosyası .gitignore'dadır, ASLA repoya eklemeyin.

# ── SMTP (varsayılan: Brevo) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=brevo_smtp_login@smtp-brevo.com
SMTP_PASS=brevo_smtp_anahtari

# Maillerin gönderileceği adres (SMTP servisinde doğrulanmış olmalı)
SENDER_EMAIL=takim@example.com

# ── Google Sheets ──
SHEETS_ID=sheets_urlsindeki_uzun_kod
SERVICE_ACCT_FILE=service_account.json

# ── Opsiyonel: gönderilen her mailin kopyasını takım Gmail'ine at ──
# SENDER_EMAIL bir Gmail adresiyse, Gmail uygulama şifresini yazın. Boşsa kopya atılmaz.
GMAIL_APP_PASSWORD=
